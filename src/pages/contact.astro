---
import PageLayout from "@/layouts/Base.astro";

const meta = {
  title: "Contact",
  description:
    "Contactez Renaud Gouffé, consultant Shopify et architecte e-commerce, pour discuter de votre projet.",
};

// Adresse email volontairement absente du HTML généré (anti-scraping) :
// chaque partie est stockée inversée dans des data-attributes,
// puis assemblée côté client par le script ci-dessous.
const reversedUser = "effuog.duaner"; // renaud.gouffe → inversé
const reversedDomain = "moc.liamg"; // gmail.com → inversé
---

<PageLayout meta={meta}>
  <section class="mx-auto w-full max-w-[720px] px-5 pt-16 pb-24 text-center sm:px-8 sm:pt-22">
    <p class="eyebrow justify-center tracking-[0.12em]">
      <span class="eyebrow-dot"></span>Rouen · Paris · Remote
    </p>
    <h1
      class="mt-5 text-[44px] leading-[1.05] font-medium tracking-[-0.025em] text-strong sm:text-[56px]"
    >
      Contact
    </h1>
    <p class="mx-auto mt-5.5 max-w-[500px] text-lg leading-[1.6] text-pretty text-text/70">
      Vous êtes un e-commerçant, une agence ou un porteur de projet Shopify ? Parlons de vos
      besoins et de vos enjeux techniques.
    </p>

    <div
      class="card mt-12 px-5 pt-10 pb-7 hover:border-white/9 sm:px-8"
      id="contact-card"
      data-u={reversedUser}
      data-d={reversedDomain}
    >
      <p class="font-mono text-[11px] tracking-[0.12em] text-text/45 uppercase">Email</p>

      <p class="mt-3.5">
        <a
          id="contact-email"
          href="#"
          class="inline-block border-b border-magenta pb-0.75 text-xl font-medium tracking-[-0.01em] break-all text-strong transition-colors hover:text-coral sm:text-[28px]"
        >
          Cliquez pour révéler l'adresse
        </a>
      </p>

      <div class="mt-7.5 flex flex-wrap items-center justify-center gap-3">
        <a id="contact-mailto" href="#" class="btn-primary">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>m'écrire
        </a>
        <button id="contact-copy" type="button" class="btn-ghost cursor-pointer">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="9" y="9" width="12" height="12" rx="2"></rect>
            <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
          </svg><span id="copy-label">copier l'adresse</span>
        </button>
      </div>
      <p class="sr-only" id="copy-feedback" aria-live="polite"></p>

      <p class="mt-7 font-mono text-xs text-text/50">Réponse sous 48 h ouvrées.</p>
      <div class="my-6 h-px bg-white/7"></div>
      <p class="text-[15px] text-text/65">
        Ou retrouvez-moi sur
        <a
          href="https://www.linkedin.com/in/renaud-gouff%C3%A9-39047287/"
          target="_blank"
          rel="nofollow noopener"
          class="link">LinkedIn</a
        >.
      </p>

      <noscript>
        <p class="mt-6 text-sm text-text/65">
          Activez JavaScript pour afficher l'adresse email (protection anti-spam), ou retrouvez-moi
          via <a href="https://www.colorz.fr" class="link">Colorz</a>.
        </p>
      </noscript>
    </div>
  </section>

  <script>
    // Assemble l'adresse côté client uniquement — jamais présente dans le HTML.
    const card = document.getElementById("contact-card");
    const emailLink = document.getElementById("contact-email");
    const mailtoBtn = document.getElementById("contact-mailto");
    const copyBtn = document.getElementById("contact-copy");
    const feedback = document.getElementById("copy-feedback");
    const label = document.getElementById("copy-label");

    const rev = (s: string) => [...s].reverse().join("");
    const user = rev(card?.dataset.u ?? "");
    const domain = rev(card?.dataset.d ?? "");
    const address = `${user}${String.fromCharCode(64)}${domain}`;
    const mailto = `mailto:${address}`;

    if (emailLink) {
      emailLink.textContent = address;
      emailLink.setAttribute("href", mailto);
    }
    mailtoBtn?.setAttribute("href", mailto);

    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(address);
      } catch {
        // Clipboard indisponible : l'adresse reste visible et sélectionnable.
        return;
      }
      if (label) label.textContent = "adresse copiée";
      copyBtn.classList.add("text-amber");
      if (feedback) feedback.textContent = "Adresse copiée";
      setTimeout(() => {
        if (label) label.textContent = "copier l'adresse";
        copyBtn.classList.remove("text-amber");
        if (feedback) feedback.textContent = "";
      }, 1600);
    });
  </script>
</PageLayout>
