---
import PageLayout from "@/layouts/Base.astro";

const meta = {
  title: "Page introuvable",
  description:
    "La page que vous cherchez n'existe pas ou a été déplacée. Revenez à l'accueil pour continuer votre navigation.",
  robots: "noindex, nofollow",
};

const links = [
  { href: "/", label: "Accueil" },
  { href: "/references", label: "Références" },
  { href: "/cv", label: "CV" },
  { href: "/contact", label: "Contact" },
];
---

<PageLayout meta={meta}>
  <section class="mx-auto max-w-[720px] px-5 pt-16 pb-24 text-center sm:px-8 sm:pt-22">
    <p class="eyebrow justify-center tracking-[0.12em]">
      <span class="eyebrow-dot"></span>Erreur 404
    </p>
    <h1
      class="mt-5 text-[36px] leading-[1.08] font-medium tracking-[-0.025em] text-balance text-strong sm:text-[48px]"
    >
      Cette page est en rupture de stock
    </h1>
    <p class="mx-auto mt-5.5 max-w-[500px] text-lg leading-[1.6] text-pretty text-text/70">
      L'adresse demandée n'existe pas ou a été déplacée. Tout le reste du catalogue est disponible :
    </p>

    <nav class="mt-8 flex flex-wrap items-center justify-center gap-3" aria-label="Pages du site">
      {
        links.map(({ href, label }, i) => (
          <a href={href} class={i === 0 ? "btn-primary" : "btn-ghost"}>
            {label.toLowerCase()}
          </a>
        ))
      }
    </nav>
  </section>
</PageLayout>
