---
import PageLayout from "@/layouts/Base.astro";
import { cvSections } from "@/data/cv";

const meta = {
  title: "Curriculum Vitae",
  description: "Retrouvez ici mon CV en ligne.",
  robots: "noindex, nofollow",
};
---

<PageLayout meta={meta}>
  <section class="mx-auto max-w-3xl px-5">
    <!-- Entête -->
    <div class="relative flex flex-col items-center gap-6 text-center">
      <div class="glow -top-10 left-1/2 h-48 w-80 -translate-x-1/2 bg-accent-2"></div>
      <span
        class="rounded-full bg-gradient-to-br from-accent via-accent-3 to-accent-2 p-[3px]"
      >
        <img
          src="/me-avatar.webp"
          alt="Portrait de Renaud Gouffé"
          width="160"
          height="160"
          class="h-40 w-40 rounded-full border-4 border-bg object-cover"
        />
      </span>
      <div>
        <h1 class="font-display text-4xl font-bold">
          <span class="gradient-text">Curriculum Vitae</span>
        </h1>
        <p class="mt-2 text-muted">
          Développeur web / Architecte technique<br />
          Rouen / Normandie
        </p>
      </div>
    </div>

    <!-- Poste actuel -->
    <div
      class="reveal mt-12 flex flex-col items-center gap-4 rounded-2xl border border-accent/40 bg-accent/10 p-6 sm:flex-row"
    >
      <a
        href="https://www.colorz.fr"
        target="_blank"
        rel="nofollow noopener"
        class="shrink-0 transition-opacity hover:opacity-80"
      >
        <img
          src="/assets/icons/colorz.svg"
          alt="Logo Colorz"
          width="64"
          height="64"
          class="h-16 w-16 object-contain brightness-0 invert"
          loading="lazy"
        />
      </a>
      <p class="text-sm leading-relaxed text-text sm:text-base">
        Actuellement en poste dans l'agence
        <a
          href="https://www.colorz.fr"
          target="_blank"
          rel="nofollow noopener"
          class="text-accent-2 underline decoration-accent-2/40 underline-offset-4 hover:decoration-accent-2"
        >Colorz</a>
        en tant qu'Architecte Solutions Shopify / Senior Lead Developer.
      </p>
    </div>

    <!-- Résumé -->
    <div
      class="reveal mt-8 space-y-4 rounded-2xl border border-line bg-surface p-7 text-sm leading-relaxed text-muted sm:text-base"
    >
      <p>
        Passionné par le web depuis 1999, j'ai fait du développement PHP et de
        l'e-commerce mon métier depuis 2003.
      </p>
      <p>
        Salarié dans l'agence <strong class="text-text">Colorz</strong> depuis 2010,
        j'ai d'abord occupé le rôle de
        <strong class="text-text">Lead Developer Magento</strong>, en pilotant des
        projets e-commerce complexes pendant près de 10 ans sur cette solution.
      </p>
      <p>
        Depuis 2019, j'interviens également en tant que
        <strong class="text-text">consultant technique e-commerce</strong>.
        J'accompagne les clients de l'agence sur des sujets comme le
        replatforming, l'architecture technique, le développement middleware ou
        encore l'intégration d'ERP.
      </p>
      <p>
        Depuis 2022, je suis <strong class="text-text">Architecte Solutions</strong>,
        spécialisé dans les problématiques avancées liées au développement sur
        Shopify.
      </p>
    </div>

    <!-- Timeline CV -->
    <div class="relative mt-14">
      <div
        class="absolute top-0 bottom-0 left-[5px] w-px"
        style="background: linear-gradient(180deg, var(--color-accent-2), var(--color-accent) 55%, var(--color-accent-3))"
        aria-hidden="true"
      >
      </div>

      {
        cvSections.map(({ category, events }) => (
          <section class="pb-4 pl-10">
            <h2 class="relative mt-8 font-display text-2xl font-bold">
              <span
                class="absolute top-2 -left-10 block h-[11px] w-[11px] rounded-full border-2 border-accent-2 bg-bg"
                aria-hidden="true"
              />
              <span class="gradient-text">{category}</span>
            </h2>
            <div class="mt-6 space-y-6">
              {events.map(({ date, title, roles, company, url, logo, logoClass }) => (
                <article class="reveal relative">
                  <span
                    class="absolute top-2 -left-[37.5px] block h-2 w-2 rounded-full bg-accent"
                    aria-hidden="true"
                  />
                  <time class="font-mono text-xs tracking-wide text-accent-2">
                    {date}
                  </time>
                  {/* Logo OU texte, jamais les deux (pas de doublon) */}
                  <h3 class="mt-2 font-display text-lg font-semibold text-text">
                    {logo ? (
                      url ? (
                        <a
                          href={url}
                          target="_blank"
                          rel="nofollow noopener"
                          class="inline-block transition-opacity hover:opacity-80"
                        >
                          <img
                            src={logo}
                            alt={title}
                            class:list={["w-auto opacity-90", logoClass]}
                            loading="lazy"
                          />
                        </a>
                      ) : (
                        <img
                          src={logo}
                          alt={title}
                          class:list={["w-auto opacity-90", logoClass]}
                          loading="lazy"
                        />
                      )
                    ) : (
                      <>
                        {url ? (
                          <a
                            href={url}
                            target="_blank"
                            rel="nofollow noopener"
                            class="transition-colors hover:text-accent-2"
                          >
                            {title}
                          </a>
                        ) : (
                          title
                        )}
                        {company && company !== title && (
                          <span class="ml-2 text-sm font-normal text-muted">
                            — {company}
                          </span>
                        )}
                      </>
                    )}
                  </h3>
                  {roles && (
                    <ul class="mt-1 space-y-0.5 text-sm text-muted">
                      {roles.map((role) => (
                        <li set:html={role} />
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</PageLayout>
