---
import PageLayout from "@/layouts/Base.astro";
import { references, platformColor } from "@/data/references";
import type { Platform } from "@/data/references";

const year = new Date().getFullYear();

const meta = {
  title: "Références",
  description:
    "Timeline des projets e-commerce réalisés en agence (Colorz) et en freelance entre 2004 et " +
    year,
  robots: "noindex, nofollow",
};

// Regroupement par année, ordre décroissant.
const sorted = [...references].sort((a, b) => b.year - a.year);
const years = [...new Set(sorted.map((r) => r.year))];
const byYear = new Map(
  years.map((y) => [y, sorted.filter((r) => r.year === y)]),
);

// Plateformes présentes (pour les filtres), Magento + Magento 2 fusionnés.
const platforms = [...new Set(references.flatMap((r) => r.techs))].sort();

const typeStyles: Record<string, string> = {
  Agence: "border-accent-2/50 text-accent-2",
  Freelance: "border-accent-3/50 text-accent-3",
};
---

<PageLayout meta={meta}>
  <section class="mx-auto max-w-4xl px-5">
    <!-- Entête -->
    <div class="relative text-center">
      <div class="glow -top-16 left-1/2 h-56 w-96 -translate-x-1/2 bg-accent"></div>
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-accent-2">
        2004 → {year}
      </p>
      <h1 class="mt-4 font-display text-4xl font-bold sm:text-5xl">
        <span class="gradient-text">Références</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-muted">
        Les références <strong class="text-text">Agence</strong> sont des projets
        réalisés en équipe au sein de l'agence
        <a
          href="https://www.colorz.fr"
          target="_blank"
          rel="nofollow noopener"
          class="text-accent-2 underline decoration-accent-2/40 underline-offset-4 hover:decoration-accent-2"
        >Colorz</a>
        entre 2010 et {year}.
      </p>
    </div>

    <!-- Filtres -->
    <div
      class="sticky top-16 z-30 -mx-5 mt-10 border-y border-line/70 bg-bg/85 px-5 py-3 backdrop-blur-md"
      id="filters"
    >
      <div class="flex flex-wrap items-center gap-2">
        <span class="mr-1 font-mono text-[0.65rem] uppercase tracking-widest text-muted">
          Type
        </span>
        {
          ["Tous", "Agence", "Freelance"].map((t) => (
            <button
              type="button"
              data-filter-type={t}
              aria-pressed={t === "Tous" ? "true" : "false"}
              class="rounded-full border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:text-text aria-pressed:border-accent aria-pressed:bg-accent/15 aria-pressed:text-text"
            >
              {t}
            </button>
          ))
        }
        <span class="mx-2 hidden h-4 w-px bg-line sm:inline-block"></span>
        <span class="mr-1 font-mono text-[0.65rem] uppercase tracking-widest text-muted">
          Plateforme
        </span>
        <button
          type="button"
          data-filter-tech="Toutes"
          aria-pressed="true"
          class="rounded-full border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:text-text aria-pressed:border-accent aria-pressed:bg-accent/15 aria-pressed:text-text"
        >
          Toutes
        </button>
        {
          platforms.map((p) => (
            <button
              type="button"
              data-filter-tech={p}
              aria-pressed="false"
              style={`--chip-color: ${platformColor[p as Platform]}`}
              class="rounded-full border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:text-text aria-pressed:border-(--chip-color) aria-pressed:text-text"
            >
              <span
                class="mr-1 inline-block h-1.5 w-1.5 rounded-full align-middle"
                style="background: var(--chip-color)"
              />
              {p}
            </button>
          ))
        }
        <span
          id="filter-count"
          class="ml-auto font-mono text-xs text-muted"
          aria-live="polite"
        >
          {references.length} missions
        </span>
      </div>
    </div>

    <!-- Timeline -->
    <div class="relative mt-12" id="timeline">
      <!-- Rail vertical en dégradé sur toute la hauteur -->
      <div
        class="absolute top-0 bottom-0 left-[7px] w-px sm:left-[9px]"
        style="background: linear-gradient(180deg, var(--color-accent-2), var(--color-accent) 45%, var(--color-accent-3))"
        aria-hidden="true"
      >
      </div>

      {
        years.map((y) => (
          <section class="year-group relative pb-4 pl-10 sm:pl-14" data-year={y}>
            <!-- Nœud d'année sur le rail -->
            <div class="year-marker absolute top-1 left-0 flex items-center gap-4 sm:top-1.5">
              <span class="year-dot relative z-10 block h-[15px] w-[15px] rounded-full border-2 border-accent-2 bg-bg sm:h-[19px] sm:w-[19px]" />
            </div>
            <h2 class="year-label pt-0.5 font-mono text-sm tracking-[0.25em] text-muted">
              {y}
            </h2>

            <ul class="mt-2">
              {byYear.get(y)?.map(({ name, type, techs }) => (
                <li
                  class="ref-card reveal group relative -ml-3 rounded-lg py-2.5 pr-3 pl-3 transition-colors duration-200 hover:bg-surface sm:-ml-4 sm:pl-4"
                  data-type={type}
                  data-techs={techs.join("|")}
                  style={`--ref-color: ${platformColor[techs[0] as Platform]}`}
                >
                  {/* Point du projet sur le rail, couleur = plateforme principale */}
                  <span
                    class="absolute top-1/2 -left-[25.5px] h-2.5 w-2.5 -translate-y-1/2 rounded-full transition-shadow duration-300 group-hover:shadow-[0_0_10px_var(--ref-color)] sm:-left-[35.5px]"
                    style="background: var(--ref-color)"
                    aria-hidden="true"
                  />
                  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1.5 sm:flex-nowrap sm:items-center">
                    <h3 class="font-display text-lg font-semibold text-text sm:min-w-44">
                      {name}
                    </h3>
                    <span
                      class:list={[
                        "rounded-full border px-2 py-px font-mono text-[0.6rem] uppercase tracking-widest",
                        typeStyles[type],
                      ]}
                    >
                      {type}
                    </span>
                    <span class="flex flex-wrap gap-1.5 sm:ml-auto">
                      {techs.map((t) => (
                        <span
                          class="rounded border px-2 py-px font-mono text-[0.65rem] uppercase tracking-wide"
                          style={`color: ${platformColor[t as Platform]}; border-color: color-mix(in oklab, ${platformColor[t as Platform]} 40%, transparent); background: color-mix(in oklab, ${platformColor[t as Platform]} 10%, transparent)`}
                        >
                          {t}
                        </span>
                      ))}
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p
      id="empty-state"
      class="mt-16 hidden text-center text-muted"
      aria-live="polite"
    >
      Aucune mission ne correspond à ces filtres.
    </p>
  </section>

  <style>
    /* Le nœud d'année s'illumine quand une carte de son groupe est révélée */
    .year-group:has(.reveal.is-visible) .year-dot {
      box-shadow:
        0 0 0 4px color-mix(in oklab, var(--color-accent-2) 25%, transparent),
        0 0 18px var(--color-accent-2);
      transition: box-shadow 0.6s ease;
    }
  </style>

  <script>
    const cards = [...document.querySelectorAll<HTMLElement>(".ref-card")];
    const yearGroups = [...document.querySelectorAll<HTMLElement>(".year-group")];
    const typeButtons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-filter-type]"),
    ];
    const techButtons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-filter-tech]"),
    ];
    const countEl = document.getElementById("filter-count");
    const emptyEl = document.getElementById("empty-state");

    let activeType = "Tous";
    let activeTech = "Toutes";

    function apply() {
      let visible = 0;
      for (const card of cards) {
        const okType = activeType === "Tous" || card.dataset.type === activeType;
        const okTech =
          activeTech === "Toutes" ||
          (card.dataset.techs ?? "").split("|").includes(activeTech);
        const show = okType && okTech;
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      }
      for (const group of yearGroups) {
        const hasVisible = group.querySelector(".ref-card:not(.hidden)") !== null;
        group.classList.toggle("hidden", !hasVisible);
      }
      if (countEl)
        countEl.textContent = `${visible} mission${visible > 1 ? "s" : ""}`;
      emptyEl?.classList.toggle("hidden", visible > 0);
    }

    for (const btn of typeButtons) {
      btn.addEventListener("click", () => {
        activeType = btn.dataset.filterType ?? "Tous";
        typeButtons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === btn)),
        );
        apply();
      });
    }
    for (const btn of techButtons) {
      btn.addEventListener("click", () => {
        activeTech = btn.dataset.filterTech ?? "Toutes";
        techButtons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === btn)),
        );
        apply();
      });
    }
  </script>
</PageLayout>
