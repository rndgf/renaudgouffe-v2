---
import PageLayout from "@/layouts/Base.astro";
import Contact from "@/components/Contact.astro";

// Icônes de ligne 24×24 (trait 1.75), une par expertise.
const services = [
  {
    label: "architecture",
    title: "Des choix techniques qui tiennent",
    text: "Cadrage, choix de plateforme, architecture applicative et SI : des décisions argumentées, alignées sur votre métier.",
    icon: ["M12 3l9 5-9 5-9-5 9-5z", "M3 13l9 5 9-5"],
  },
  {
    label: "replatforming",
    title: "Changer de plateforme sans casser l'existant",
    text: "Audit de l'existant, trajectoire de migration, reprise des données et accompagnement jusqu'à la mise en ligne.",
    icon: ["M16 3l4 4-4 4", "M20 7H8", "M8 21l-4-4 4-4", "M4 17h12"],
  },
  {
    label: "intégrations",
    title: "Un écosystème connecté",
    text: "Middleware et connecteurs entre la boutique et le système d'information : ERP, PIM, OMS, marketplace Mirakl.",
    icon: [
      "M9.5 14.5l5-5",
      "M11 6.5l1-1a4 4 0 0 1 5.7 5.7l-2 2",
      "M13 17.5l-1 1a4 4 0 0 1-5.7-5.7l2-2",
    ],
  },
  {
    label: "développement",
    title: "Le code, quand il le faut",
    text: "Développement sur-mesure, checkout et promotions avancées, audit et montée en qualité, en renfort de vos équipes.",
    icon: ["M8 7l-5 5 5 5", "M16 7l5 5-5 5"],
    more: { href: "/freelance-shopify", label: "freelance shopify →" },
  },
];

---

<PageLayout
  meta={{
    title: "Architecte Solutions Shopify — architecture e-commerce et intégrations",
  }}
>
  <div class="mx-auto max-w-[1040px] px-5 sm:px-8">
    <!-- Hero -->
    <section class="pt-16 pb-14 sm:pt-24 sm:pb-18">
      <p class="eyebrow"><span class="eyebrow-dot"></span>Architecte solutions e-commerce</p>
      <h1
        class="mt-5.5 text-[40px] leading-[1.06] font-medium tracking-[-0.025em] text-pretty text-strong sm:text-[56px]"
      >
        Des plateformes e-commerce pensées pour durer.
      </h1>
      <p class="mt-6.5 max-w-[760px] text-lg leading-[1.65] text-pretty text-text/70">
        Architecte solutions e-commerce, j'accompagne marques et agences dans leurs choix
        structurants : replatforming, architecture SI, intégrations, marketplace. Shopify
        aujourd'hui, Magento pendant dix ans, et le code quand il faut mettre les mains dedans.
      </p>
      <ul class="mt-7 flex flex-wrap gap-x-5.5 gap-y-2 font-mono text-xs text-text/50">
        <li>rouen · normandie</li>
        <li>21 ans d'e-commerce</li>
        <li>shopify · magento · mirakl</li>
        <li>solution architect @ colorz</li>
      </ul>
    </section>

    <!-- Expertises -->
    <section class="pb-6">
      <h2 class="eyebrow mb-3.5">Expertises</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-3.5">
        {
          services.map(({ label, title, text, icon, more }) => (
            <article class="card px-7 py-6.5">
              <div class="flex items-center gap-3">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-text/78"
                  aria-hidden="true"
                >
                  {icon.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
                <span class="font-mono text-xs text-text/62">{label}</span>
              </div>
              <h3 class="mt-4.5 text-[21px] leading-tight font-medium text-strong">{title}</h3>
              <p class="mt-2.5 text-[15.5px] leading-[1.62] text-text/66">{text}</p>
              {more && (
                <a
                  href={more.href}
                  class="mt-3.5 inline-flex items-center gap-1.5 font-mono text-xs text-coral transition-colors hover:text-strong"
                >
                  {more.label}
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <!-- En bref -->
    <section class="pt-16">
      <h2 class="eyebrow mb-3.5">En bref</h2>
      <div class="card px-6 pt-8 pb-7 hover:border-white/9 sm:px-11 sm:pt-10 sm:pb-8">
        <div class="max-w-[820px]">
          <p class="text-[23px] leading-[1.6] text-pretty text-text/92">
            « Forgée en freelance puis au sein de l'agence
            <a href="https://www.colorz.fr" target="_blank" rel="nofollow noopener" class="link"
              >Colorz</a
            >, mon expertise repose sur une vraie compréhension de vos enjeux techniques comme
            métiers.
          </p>
          <p class="mt-4.5 text-[23px] leading-[1.6] text-pretty text-text/92">
            Plus de 21 ans d'expérience, aujourd'hui au service de mes clients comme Solution
            Architect Shopify et Senior Lead Developer. »
          </p>
        </div>
        <div
          class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-4 border-t border-white/7 pt-6"
        >
          <div class="flex items-center gap-4">
            <span
              class="flex size-11 shrink-0 items-center justify-center rounded-md bg-[linear-gradient(155deg,#873579,#B14675,#E36261)] font-mono text-sm font-medium text-white"
              aria-hidden="true">RG</span
            >
            <div class="flex flex-col gap-1">
              <span class="text-base font-medium text-strong">Renaud Gouffé</span>
              <span class="font-mono text-xs text-text/55">
                solution architect ·
                <a
                  href="https://www.colorz.fr"
                  target="_blank"
                  rel="nofollow noopener"
                  class="border-b border-coral text-text transition-colors hover:text-coral"
                  >colorz</a
                >
                · depuis 2003
              </span>
            </div>
          </div>
          <a
            href="/cv"
            class="flex items-center gap-2 font-mono text-[13px] text-text transition-colors hover:text-coral"
          >
            voir le parcours <span class="text-coral">→</span>
          </a>
        </div>
      </div>
    </section>

    <Contact
      title="Parlons de votre projet e-commerce"
      text="E-commerçant, agence ou porteur de projet ? Décrivez-moi votre besoin, je vous réponds rapidement."
    />
  </div>
</PageLayout>
