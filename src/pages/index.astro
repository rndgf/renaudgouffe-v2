---
import PageLayout from "@/layouts/Base.astro";
import Contact from "@/components/Contact.astro";
import ArchitectFlow from "@/components/ArchitectFlow.astro";
import type { FlowStep } from "@/components/ArchitectFlow.astro";

// Étapes du schéma, de l'écoute à la mise en production.
const steps: FlowStep[] = [
  {
    tag: "Écouter",
    title: "Comprendre le métier",
    text: "Discuter avec les acteurs métier, cartographier les process et comprendre les contraintes du SI.",
    kind: "node",
    panel: "Cadrage & architecture",
  },
  {
    tag: "Architecturer",
    title: "Définir l'architecture",
    text: "Choix de la plateforme cible, interfaces entre les différentes briques de l'écosystème (ERP, OMS, PIM, marketplace...).",
    kind: "fork",
    panel: "Cadrage & architecture",
  },
  {
    tag: "Cadrer",
    title: "Écrire les intentions",
    text: "En se basant sur SDD : définir les intentions et les ADRs, verrouiller le périmètre et les contrats d'interface.",
    kind: "node",
    panel: "Cadrage & architecture",
  },
  {
    tag: "Développer",
    title: "Développer avec des agents",
    text: "Les agents codent, bornés par la spécification et les harnais. Des développeurs relisent et valident.",
    kind: "fork",
    panel: "Développement, tests et livraison",
  },
  {
    tag: "Tester",
    title: "Vérifier avant de livrer",
    text: "Tests unitaires, end-to-end, stress tests.",
    kind: "test",
    lanes: 3,
    panel: "Développement, tests et livraison",
  },
  {
    tag: "Livrer",
    title: "Déployer en production",
    text: "CI/CD, déploiement, playbook, plans de bascule, jusqu'au go-live.",
    kind: "node",
    panel: "Développement, tests et livraison",
  },
];
---

<PageLayout
  meta={{
    title: "Architecte e-commerce — cadrage, intégrations SI et développement Shopify",
  }}
>
  <div class="mx-auto max-w-[1240px] px-5 sm:px-8">
    <section class="pt-12 sm:pt-18">
      <p class="eyebrow flex-wrap gap-x-2.5 gap-y-2">
        <span class="text-strong">Renaud Gouffé</span>
        <span class="hidden text-text/40 sm:inline" aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1.5 whitespace-nowrap">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="-mr-1"
          aria-hidden="true"
        >
          <path d="M12 21s7-6.3 7-11.5A7 7 0 0 0 5 9.5C5 14.7 12 21 12 21z"></path>
          <circle cx="12" cy="9.5" r="2.5"></circle>
        </svg>
        Rouen
        </span>
        <span class="hidden text-text/40 sm:inline" aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1.5 whitespace-nowrap">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="-mr-1"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="12" rx="2"></rect>
          <path d="M8 20h8M12 16v4"></path>
        </svg>
        remote / hybride
        </span>
      </p>
      <h1
        class="mt-4.5 text-[38px] leading-[1.04] font-semibold tracking-[-0.03em] text-balance text-strong sm:text-[56px] lg:text-[68px] lg:whitespace-nowrap"
      >
        Architecte Solutions <span class="whitespace-nowrap">e‑commerce</span>
      </h1>
      <p
        class="mt-5 text-[21px] leading-[1.3] tracking-[-0.01em] text-text/80 sm:text-[26px] lg:whitespace-nowrap"
      >
        Spécialisé Shopify, du cadrage à la mise en production.
      </p>

      <!-- Qui je suis / ce que je fais -->
      <div class="mt-16 grid gap-5 md:grid-cols-2">
        <div class="card card-lift px-6 pt-6 pb-6.5">
          <h2
            class="mb-2.5 flex items-center gap-2.5 text-base font-medium text-text/72 before:size-3 before:rounded-full before:bg-teal before:content-['']"
          >
            Qui je suis
          </h2>
          <p class="text-[17px] leading-[1.62] text-pretty text-text/66">
            Je suis développeur à l'origine. Passionné par le web depuis 1999, j'ai fait du
            développement PHP et de l'e&#8209;commerce mon métier dès 2003.<br/>Chez
            <a href="https://www.colorz.fr" target="_blank" rel="nofollow noopener" class="link"
              >Colorz</a
            > depuis 2010, j'ai été Lead Developer Magento pendant près de dix ans, je vis à Rouen en Normandie, je travaille en remote / hybride.
          </p>
        </div>
        <div class="card card-lift-accent px-6 pt-6 pb-6.5">
          <h2
            class="mb-2.5 flex items-center gap-2.5 text-base font-medium text-coral before:size-3 before:bg-current before:content-['']"
          >
            Ce que je fais
          </h2>
          <p class="text-[17px] leading-[1.62] text-pretty text-text/90">
            Je suis Solutions Architect Shopify : je comprends ce que veulent les équipes métier, je
            cadre les choix de plateforme et d'intégration, puis je suis les projets jusqu'à la mise
            en production, en codant encore, avec des agents que j'apprends à piloter. Voici
            comment, étape par étape.
          </p>
        </div>
      </div>

      <h2 class="mt-16 text-[30px] leading-tight font-semibold tracking-[-0.015em] text-strong">
        Comment je travaille aujourd'hui
      </h2>
      <ArchitectFlow steps={steps} />
    </section>

    <div class="-mt-4">
      <Contact
        title="Échangeons"
        text="Replatforming, intégration SI, question d'architecture ou de code : écrivez-moi."
      />
    </div>
  </div>
</PageLayout>
