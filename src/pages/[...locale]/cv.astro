---
import PageLayout from "@/layouts/Base.astro";
import Contact from "@/components/Contact.astro";
import { cvSections } from "@/data/cv";
import { localeOf, t } from "@/i18n";

export { getStaticPaths } from "@/i18n";

const locale = localeOf(Astro.currentLocale);
const copy = {
  fr: {
    title: "Curriculum Vitae",
    description: "Retrouvez ici mon CV en ligne.",
    eyebrow: "Curriculum vitae",
    h1: "Architecte Solutions E-Commerce",
    location: "lieu",
    role: "poste",
    agency: "agence",
    inShort: "En bref",
    summary: [
      "Passionné par le web depuis 1999, j'ai fait du développement PHP et de l'e-commerce mon métier depuis 2003.",
      "Salarié dans l'agence Colorz depuis 2010, j'ai d'abord occupé le rôle de Senior Lead Developer Magento, en pilotant des projets e-commerce complexes pendant près de 10 ans sur cette solution.",
      "Depuis 2019, j'interviens également en tant que consultant technique e-commerce. J'accompagne les clients de l'agence sur des sujets comme le replatforming, l'architecture technique, le développement middleware ou encore l'intégration d'ERP.",
      "Depuis 2020, je suis Solutions Architect, spécialisé dans les problématiques avancées liées au développement sur Shopify.",
    ],
    ctaTitle: "Échangeons",
    ctaText: "Architecture e-commerce, intégration SI ou question technique : écrivez-moi.",
  },
  en: {
    title: "About",
    description: "My résumé, online.",
    eyebrow: "Résumé",
    h1: "E-Commerce Solutions Architect",
    location: "location",
    role: "role",
    agency: "agency",
    inShort: "In short",
    summary: [
      "Passionate about the web since 1999, I made PHP development and e-commerce my job in 2003.",
      "Employed at the Colorz agency since 2010, I first held the role of Senior Lead Developer Magento, driving complex e-commerce projects on that platform for almost 10 years.",
      "Since 2019, I also work as a technical e-commerce consultant. I support the agency's clients on topics such as replatforming, technical architecture, middleware development and ERP integration.",
      "Since 2020, I am a Solutions Architect, specialised in advanced Shopify development topics.",
    ],
    ctaTitle: "Let's talk",
    ctaText: "E-commerce architecture, system integration or technical question: drop me a line.",
  },
}[locale];

const meta = { title: copy.title, description: copy.description, robots: "noindex, nofollow" };

const identity = [
  { label: copy.location, value: locale === "en" ? "rouen · normandy" : "rouen · normandie" },
  { label: copy.role, value: "solutions architect shopify · senior lead developer" },
];
---

<PageLayout meta={meta}>
  <div class="mx-auto max-w-[880px] px-5 sm:px-8">
    <!-- Entête -->
    <section class="pt-16 pb-10 sm:pt-22">
      <p class="eyebrow"><span class="eyebrow-dot"></span>{copy.eyebrow}</p>
      <h1
        class="mt-5.5 text-[36px] leading-[1.08] font-medium tracking-[-0.025em] text-balance text-strong sm:text-[48px]"
      >
        {copy.h1}
      </h1>
      <dl
        class="mt-7 grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-5.5 gap-y-2.5 font-mono text-[13px]"
      >
        {
          identity.map(({ label, value }) => (
            <>
              <dt class="text-[10px] tracking-widest text-text/42 uppercase">{label}</dt>
              <dd class="text-text">{value}</dd>
            </>
          ))
        }
        <dt class="text-[10px] tracking-widest text-text/42 uppercase">{copy.agency}</dt>
        <dd>
          <a
            href="https://www.colorz.fr"
            target="_blank"
            rel="nofollow noopener"
            class="text-coral transition-colors hover:text-strong">colorz</a
          >
        </dd>
      </dl>
    </section>

    <!-- En bref -->
    <section class="pb-2">
      <h2 class="eyebrow mb-3.5">{copy.inShort}</h2>
      <div class="card card-lift flex flex-col gap-3.5 px-6 py-7 hover:border-text/14 sm:px-8">
        {copy.summary.map((p) => <p class="text-[16.5px] leading-[1.7] text-text/82">{p}</p>)}
      </div>
    </section>

    <!-- Timeline -->
    <section class="pt-14">
      <div class="relative pl-8.5">
        <div class="absolute top-2.5 bottom-0 left-1.5 w-px bg-white/12" aria-hidden="true"></div>
        {
          cvSections.map(({ category, events }) => (
            <section class="relative pb-7">
              <span
                class="absolute top-1.25 -left-8.5 size-3.25 rounded-full border-2 border-coral bg-bg"
                aria-hidden="true"
              />
              <h2 class="font-mono text-xs leading-6 font-medium tracking-[0.08em] text-coral uppercase">
                {t(category, locale)}
              </h2>
              <div class="mt-7 flex flex-col gap-7.5">
                {events.map(({ date, title, lines, org, current }) => (
                  <article class="relative">
                    <span
                      class:list={[
                        "absolute top-1 -left-7.75 size-1.75 rounded-xs",
                        current ? "bg-amber" : "bg-text/40",
                      ]}
                      aria-hidden="true"
                    />
                    <p
                      class:list={[
                        "font-mono text-xs leading-[1.2]",
                        current ? "text-amber" : "text-text/55",
                      ]}
                    >
                      {t(date, locale)}
                    </p>
                    {org === "colorz" && (
                      <img
                        src="/assets/icons/colorz.svg"
                        alt="Colorz"
                        height="24"
                        class="mt-3 block h-6 w-auto brightness-0 invert"
                        loading="lazy"
                      />
                    )}
                    {org === "ftel" && (
                      <p class="mt-2.5 text-[28px] leading-none font-light tracking-[-0.02em] text-strong italic">
                        ftel
                      </p>
                    )}
                    {title && (
                      <h3 class="mt-2 text-[19px] leading-[1.35] font-medium text-pretty text-strong">
                        {t(title, locale)}
                      </h3>
                    )}
                    {lines.length > 0 && (
                      <ul class="mt-2 flex flex-col gap-0.5 text-base leading-normal text-text/68">
                        {lines.map((line) => (
                          <li>{t(line, locale)}</li>
                        ))}
                      </ul>
                    )}
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <Contact title={copy.ctaTitle} text={copy.ctaText} />
  </div>
</PageLayout>
