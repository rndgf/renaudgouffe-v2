---
import PageLayout from "@/layouts/Base.astro";
import Contact from "@/components/Contact.astro";
import ArchitectFlow from "@/components/ArchitectFlow.astro";
import type { FlowStep } from "@/components/ArchitectFlow.astro";
import { SHOPIFY_ICON } from "@/data/shopify-icon";
import { localeOf, type Locale } from "@/i18n";

export { getStaticPaths } from "@/i18n";

const locale = localeOf(Astro.currentLocale);

// Textes de la page, puis étapes du schéma (de l'écoute à la mise en production).
// Le satisfies type les triplets [étiquette, titre, texte] en tuples.
const copy = ({
  fr: {
    title: "Architecte e-commerce — cadrage, intégrations SI et développement Shopify",
    remote: "remote / hybride",
    h1: "Architecte Solutions e‑commerce",
    tagline: "Spécialisé Shopify, du cadrage à la mise en production.",
    whoTitle: "Qui je suis",
    who1: "Je suis développeur à l'origine. Passionné par le web depuis 1999, j'ai fait du développement PHP et de l'e‑commerce mon métier dès 2003.",
    whoBefore: "Chez ",
    whoAfter:
      " depuis 2010, j'ai été Lead Developer Magento pendant près de dix ans, je vis à Rouen en Normandie, je travaille en remote / hybride.",
    whatTitle: "Ce que je fais",
    what: "Je suis Solutions Architect Shopify : je comprends ce que veulent les équipes métier, je cadre les choix de plateforme et d'intégration, puis je suis les projets jusqu'à la mise en production, en codant encore, avec des agents que j'apprends à piloter. Voici comment, étape par étape.",
    how: "Comment je travaille aujourd'hui",
    ctaTitle: "Échangeons",
    ctaText: "Replatforming, intégration SI, question d'architecture ou de code : écrivez-moi.",
    scoping: "Cadrage & architecture",
    delivery: "Développement, tests et livraison",
    steps: [
      ["Écouter", "Comprendre le métier", "Discuter avec les acteurs métier, cartographier les process et comprendre les contraintes du SI."],
      ["Architecturer", "Définir l'architecture", "Shopify comme plateforme cible, interfaces entre les différentes briques de l'écosystème (ERP, OMS, PIM, marketplace...)."],
      ["Cadrer", "Écrire les intentions", "En se basant sur SDD : définir les intentions et les ADRs, verrouiller le périmètre et les contrats d'interface."],
      ["Développer", "Développer avec des agents", "Les agents codent, bornés par la spécification et les harnais. Des développeurs relisent et valident."],
      ["Tester", "Vérifier avant de livrer", "Tests unitaires, end-to-end, stress tests."],
      ["Livrer", "Déployer en production", "CI/CD, déploiement, playbook, plans de bascule, jusqu'au go-live."],
    ],
  },
  en: {
    title: "E-commerce architect — scoping, system integrations and Shopify development",
    remote: "remote / hybrid",
    h1: "E‑commerce Solutions Architect",
    tagline: "Shopify specialist, from scoping to go-live.",
    whoTitle: "Who I am",
    who1: "I am a developer at heart. Passionate about the web since 1999, I made PHP development and e‑commerce my job in 2003.",
    whoBefore: "At ",
    whoAfter:
      " since 2010, I was Magento Lead Developer for almost ten years. I live in Rouen, Normandy, and work remote / hybrid.",
    whatTitle: "What I do",
    what: "I am a Shopify Solutions Architect: I understand what business teams want, I frame platform and integration choices, then I follow projects through to production, still writing code, with agents I am learning to drive. Here is how, step by step.",
    how: "How I work today",
    ctaTitle: "Let's talk",
    ctaText: "Replatforming, system integration, architecture or code question: drop me a line.",
    scoping: "Scoping & architecture",
    delivery: "Development, testing and delivery",
    steps: [
      ["Listen", "Understand the business", "Talk with business stakeholders, map the processes and understand the constraints of the information system."],
      ["Architect", "Define the architecture", "Shopify as the target platform, interfaces between the building blocks of the ecosystem (ERP, OMS, PIM, marketplace...)."],
      ["Scope", "Write the intentions", "Based on SDD: define intentions and ADRs, lock the scope and the interface contracts."],
      ["Build", "Develop with agents", "Agents write the code, bounded by the specification and the harnesses. Developers review and validate."],
      ["Test", "Check before shipping", "Unit tests, end-to-end tests, stress tests."],
      ["Ship", "Deploy to production", "CI/CD, deployment, playbook, cut-over plans, up to go-live."],
    ],
  },
} satisfies Record<Locale, { steps: [string, string, string][] } & Record<string, unknown>>)[locale];

const shapes: Pick<FlowStep, "kind" | "lanes">[] = [
  { kind: "node" },
  { kind: "fork" },
  { kind: "node" },
  { kind: "fork" },
  { kind: "test", lanes: 3 },
  { kind: "node" },
];
const steps: FlowStep[] = copy.steps.map(([tag, title, text], i) => ({
  tag,
  title,
  text,
  ...shapes[i]!,
  panel: i < 3 ? copy.scoping : copy.delivery,
}));
---

<PageLayout meta={{ title: copy.title }}>
  <div class="mx-auto max-w-[1240px] px-5 sm:px-8">
    <section class="pt-8 sm:pt-18">
      <p class="eyebrow gap-2 text-[10.5px] tracking-[0.05em] whitespace-nowrap sm:gap-2.5 sm:text-xs sm:tracking-[0.08em]">
        <span class="text-strong">Renaud Gouffé</span>
        <span class="text-text/40" aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1.5 whitespace-nowrap">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21s7-6.3 7-11.5A7 7 0 0 0 5 9.5C5 14.7 12 21 12 21z"></path>
          <circle cx="12" cy="9.5" r="2.5"></circle>
        </svg>
        Rouen
        </span>
        <span class="text-text/40" aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1.5 whitespace-nowrap">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="-mr-1"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="12" rx="2"></rect>
          <path d="M8 20h8M12 16v4"></path>
        </svg>
        {copy.remote}
        </span>
      </p>
      <h1
        class="mt-4.5 text-[38px] leading-[1.04] font-semibold tracking-[-0.03em] text-balance text-strong sm:text-[56px] lg:text-[68px] lg:whitespace-nowrap"
      >
        {copy.h1}
      </h1>
      <p
        class="mt-5 flex items-center gap-2.5 text-[21px] leading-[1.3] tracking-[-0.01em] text-text/80 sm:gap-3 sm:text-[26px] lg:whitespace-nowrap"
      >
        <svg
          viewBox={SHOPIFY_ICON.viewBox}
          class="size-[0.95em] shrink-0 text-strong"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={SHOPIFY_ICON.path}></path>
        </svg>
        <span>{copy.tagline}</span>
      </p>

      <!-- Qui je suis / ce que je fais -->
      <div class="mt-9 grid gap-5 sm:mt-16 md:grid-cols-2">
        <div class="card card-lift px-6 pt-6 pb-6.5">
          <h2
            class="mb-2.5 flex items-center gap-2.5 text-base font-medium text-text/72 before:size-3 before:rounded-full before:bg-teal before:content-['']"
          >
            {copy.whoTitle}
          </h2>
          <p class="text-[17px] leading-[1.62] text-pretty text-text/66">
            {copy.who1}<br />{copy.whoBefore}<a
              href="https://www.colorz.fr"
              target="_blank"
              rel="nofollow noopener"
              class="link">Colorz</a
            >{copy.whoAfter}
          </p>
        </div>
        <div class="card card-lift-accent px-6 pt-6 pb-6.5">
          <h2
            class="mb-2.5 flex items-center gap-2.5 text-base font-medium text-coral before:size-3 before:bg-current before:content-['']"
          >
            {copy.whatTitle}
          </h2>
          <p class="text-[17px] leading-[1.62] text-pretty text-text/90">{copy.what}</p>
        </div>
      </div>

      <h2
        class="mt-9 text-[20px] leading-tight font-semibold tracking-[-0.015em] whitespace-nowrap text-strong sm:mt-16 sm:text-[30px]"
      >
        {copy.how}
      </h2>
      <ArchitectFlow steps={steps} />
    </section>

    <div class="sm:-mt-4">
      <Contact title={copy.ctaTitle} text={copy.ctaText} />
    </div>
  </div>
</PageLayout>
