---
import PageLayout from "@/layouts/Base.astro";
import { references } from "@/data/references";
import type { Reference } from "@/data/references";
import { SHOPIFY_ICON } from "@/data/shopify-icon";
import { localeOf, t, ui } from "@/i18n";

export { getStaticPaths } from "@/i18n";

const year = new Date().getFullYear();
const locale = localeOf(Astro.currentLocale);
const copy = {
  fr: {
    title: "Références",
    description: `Projets e-commerce réalisés en agence (Colorz) et en freelance entre 2001 et ${year} : Shopify, Magento, développement web.`,
    introBefore: "Les projets marqués ",
    agency: "Agence",
    introMiddle: " ont été réalisés en équipe au sein de l'agence ",
    introAfter: ` entre 2010 et ${year}.`,
    projects: "projets",
    shopify:
      "Migrations, intégrations Mirakl / ERP et checkout sur-mesure — le cœur de mon activité de Solutions Architect depuis 2020.",
    magento:
      "Près de 10 ans de plateformes Magento complexes, en agence comme en freelance. Le socle technique qui a forgé l'architecte.",
    webTitle: "Projets web",
    web: "Du premier projet en 2002 aux sites modernes d'aujourd'hui : WordPress, développements sur-mesure, Astro.",
    roles: { architecte: "Architecture", dev: "Développement", design: "Design" },
    custom: "Sur-mesure",
  },
  en: {
    title: "References",
    description: `E-commerce projects delivered in agency (Colorz) and as a freelancer between 2001 and ${year}: Shopify, Magento, web development.`,
    introBefore: "Projects marked ",
    agency: "Agency",
    introMiddle: " were delivered as a team at the ",
    introAfter: ` agency between 2010 and ${year}.`,
    projects: "projects",
    shopify:
      "Migrations, Mirakl / ERP integrations and custom checkout — the core of my Solutions Architect work since 2020.",
    magento:
      "Almost 10 years of complex Magento platforms, in agency and as a freelancer. The technical foundation that shaped the architect.",
    webTitle: "Web projects",
    web: "From the first project in 2002 to today's modern sites: WordPress, custom development, Astro.",
    roles: { architecte: "Architecture", dev: "Development", design: "Design" },
    custom: "Custom",
  },
}[locale];

const meta = { title: copy.title, description: copy.description, robots: "noindex, nofollow" };

// Trois ères d'expertise, la plus récente d'abord — même donnée, autre récit.
function era(r: Reference): "shopify" | "magento" | "web" {
  if (r.techs.includes("Shopify")) return "shopify";
  if (r.techs.some((t) => t.startsWith("Magento"))) return "magento";
  return "web";
}

const chapters = [
  {
    key: "shopify",
    title: "Shopify",
    intro: copy.shopify,
    iconPath: SHOPIFY_ICON.path,
    iconViewBox: SHOPIFY_ICON.viewBox,
  },
  {
    key: "magento",
    title: "Magento",
    intro: copy.magento,
    // Logo Magento — Font Awesome Brands (fa-magento), CC BY 4.0
    iconPath:
      "M445.7 127.9V384l-63.4 36.5V164.7L223.8 73.1 65.2 164.7l.4 255.9L2.3 384V128.1L224.2 0l221.5 127.9zM255.6 420.5L224 438.9l-31.8-18.2v-256l-63.3 36.6.1 255.9 94.9 54.9 95.1-54.9v-256l-63.4-36.6v255.9z",
    iconViewBox: "0 0 448 512",
  },
  {
    key: "web",
    title: copy.webTitle,
    intro: copy.web,
    // Globe — Font Awesome Solid (fa-globe), CC BY 4.0
    iconPath:
      "M352 256c0 22.2-1.2 43.6-3.3 64H163.3c-2.2-20.4-3.3-41.8-3.3-64s1.2-43.6 3.3-64H348.7c2.2 20.4 3.3 41.8 3.3 64zm28.8-64H503.9c5.3 20.5 8.1 41.9 8.1 64s-2.8 43.5-8.1 64H380.8c2.1-20.6 3.2-42 3.2-64s-1.1-43.4-3.2-64zm112.6-32H376.7c-10-63.9-29.8-117.4-55.3-151.6c78.3 20.7 142 77.5 171.9 151.6zm-149.1 0H167.7c6.1-36.4 15.5-68.6 27-94.7c10.5-23.6 22.2-40.7 33.5-51.5C239.4 3.2 248.7 0 256 0s16.6 3.2 27.8 13.8c11.3 10.8 23 27.9 33.5 51.5c11.6 26 20.9 58.2 27 94.7zm-209 0H18.6C48.6 85.9 112.2 29.1 190.6 8.4C165.1 42.6 145.3 96.1 135.3 160zM8.1 192H131.2c-2.1 20.6-3.2 42-3.2 64s1.1 43.4 3.2 64H8.1C2.8 299.5 0 278.1 0 256s2.8-43.5 8.1-64zM194.7 446.6c-11.6-26-20.9-58.2-27-94.6H344.3c-6.1 36.4-15.5 68.6-27 94.6c-10.5 23.6-22.2 40.7-33.5 51.5C272.6 508.8 263.3 512 256 512s-16.6-3.2-27.8-13.8c-11.3-10.8-23-27.9-33.5-51.5zM135.3 352c10 63.9 29.8 117.4 55.3 151.6C112.2 482.9 48.6 426.1 18.6 352H135.3zm358.1 0c-30 74.1-93.6 130.9-171.9 151.6c25.5-34.2 45.2-87.7 55.3-151.6H493.4z",
    iconViewBox: "0 0 512 512",
  },
].map((c) => {
  const projects = references
    .filter((r) => era(r) === c.key)
    .sort((a, b) => b.year - a.year);
  const years = projects.map((p) => p.year);
  return {
    ...c,
    projects,
    count: projects.length,
    from: Math.min(...years),
    to: Math.max(...years),
  };
});

// Rôles tenus sur le projet, affichés en toutes lettres en pied de carte.
const roleLabels: Record<string, { label: string; color: string }> = {
  architecte: { label: copy.roles.architecte, color: "var(--color-teal)" },
  dev: { label: copy.roles.dev, color: "var(--color-coral)" },
  design: { label: copy.roles.design, color: "var(--color-amber)" },
};
---

<PageLayout meta={meta}>
  <div class="mx-auto max-w-[1040px] px-5 sm:px-8">
    <!-- Entête -->
    <section class="pt-16 pb-14 text-center sm:pt-20 sm:pb-16">
      <p class="eyebrow justify-center">
        <span class="eyebrow-dot"></span>Portfolio · 2002 → {year}
      </p>
      <h1
        class="mt-5 text-[40px] leading-[1.06] font-medium tracking-[-0.025em] text-strong sm:text-[52px]"
      >
        {copy.title}
      </h1>
      <p class="mx-auto mt-5 text-[17px] leading-[1.62] text-pretty text-text/70">
        {copy.introBefore}<span class="font-medium text-strong">{copy.agency}</span>{copy.introMiddle}<a
          href="https://www.colorz.fr"
          target="_blank"
          rel="nofollow noopener"
          class="link">Colorz</a
        >{copy.introAfter}
      </p>
    </section>

    <!-- Chapitres -->
    {
      chapters.map(({ key, title, intro, projects, count, from, to, iconPath, iconViewBox }) => (
        <section class="flex flex-wrap items-start gap-x-14 gap-y-10 pb-22">
          <header class="flex-[1_1_280px] md:sticky md:top-24">
            <p class="font-mono text-xs tracking-[0.12em] text-coral">
              {from} → {to}
            </p>
            <h2 class="mt-3 flex items-center gap-3 text-[32px] font-medium tracking-[-0.015em] text-strong">
              <span class="flex size-8.5 shrink-0 items-center justify-center rounded-md border border-white/16 text-text/85">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox={iconViewBox}
                  class="size-4.5"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={iconPath} />
                </svg>
              </span>
              {title}
            </h2>
            <p class="mt-4 text-[15.5px] leading-[1.65] text-pretty text-text/68">{intro}</p>
            <p class="mt-5.5 flex items-baseline gap-3">
              <span class="text-[44px] leading-none font-medium text-strong tabular-nums">
                {count}
              </span>
              <span class="font-mono text-[11px] tracking-[0.12em] text-text/50 uppercase">
                {copy.projects}
              </span>
            </p>
          </header>

          <ul class="grid flex-[2_1_460px] grid-cols-[repeat(auto-fill,minmax(210px,1fr))] gap-2.5">
            {projects.map(({ name, year: y, type, techs, tagline, roles }) => {
              // Chapitre Shopify : le tag SHOPIFY est redondant, on ne montre que
              // les technologies différenciantes (Mirakl, Cegid…). Chapitre Magento :
              // MAGENTO et MAGENTO 2 restent, la version distingue les projets.
              const visibleTechs = techs.filter((tech) => !(key === "shopify" && tech === "Shopify"));
              return (
                <li class="card flex flex-col px-4 py-3.5">
                  <div class="flex items-baseline justify-between gap-2.5">
                    <h3 class="text-base font-medium text-strong">{name}</h3>
                    <span class="font-mono text-[11px] text-text/50">{y}</span>
                  </div>
                  {tagline && (
                    <p class="mt-1 text-[13.5px] leading-[1.45] text-text/62">{t(tagline, locale)}</p>
                  )}
                  <div class="mt-3.5 flex min-h-5 flex-wrap gap-1.5">
                    {visibleTechs.map((tech) => (
                      <span class="rounded-[3px] bg-white/6 px-1.75 py-0.5 font-mono text-[10px] tracking-[0.04em] text-text/72 uppercase">
                        {tech === "Sur-mesure" ? copy.custom : tech}
                      </span>
                    ))}
                  </div>
                  <div class="min-h-4 flex-1" />
                  <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5 border-t border-white/6 pt-3 font-mono text-[10.5px] text-text/55">
                    {roles?.map((role) => {
                      const { label, color } = roleLabels[role] ?? {
                        label: role,
                        color: "var(--color-text)",
                      };
                      return (
                        <span class="flex items-center gap-1.5">
                          <span
                            class="size-1.5 rounded-full"
                            style={`background: ${color}`}
                            aria-hidden="true"
                          />
                          {label}
                        </span>
                      );
                    })}
                    <span class="ml-auto text-text/45">{ui[locale].referenceType[type]}</span>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</PageLayout>
