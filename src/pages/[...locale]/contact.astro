---
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";
import { localeOf } from "@/i18n";

export { getStaticPaths } from "@/i18n";

const locale = localeOf(Astro.currentLocale);
const copy = {
  fr: {
    title: "Contact",
    description:
      "Contactez Renaud Gouffé, consultant Shopify et architecte e-commerce, pour discuter de votre projet.",
    intro:
      "Vous êtes un e-commerçant, une agence ou un porteur de projet Shopify ? Parlons de vos besoins et de vos enjeux techniques.",
    reveal: "Cliquez pour révéler l'adresse",
    orLinkedin: "Ou retrouvez-moi sur ",
    noscriptBefore: "Activez JavaScript pour afficher l'adresse email (protection anti-spam), ou retrouvez-moi via ",
  },
  en: {
    title: "Contact",
    description:
      "Get in touch with Renaud Gouffé, Shopify consultant and e-commerce architect, to discuss your project.",
    intro:
      "Are you a merchant, an agency or planning a Shopify project? Let's talk about your needs and technical challenges.",
    reveal: "Click to reveal the address",
    orLinkedin: "Or find me on ",
    noscriptBefore: "Enable JavaScript to display the email address (anti-spam protection), or find me via ",
  },
}[locale];

const meta = { title: copy.title, description: copy.description };

// Adresse email volontairement absente du HTML généré (anti-scraping) :
// chaque partie est stockée inversée dans des data-attributes,
// puis assemblée côté client par le script ci-dessous.
const reversedUser = "effuog.duaner"; // renaud.gouffe → inversé
const reversedDomain = "moc.liamg"; // gmail.com → inversé
---

<PageLayout meta={meta}>
  <section class="mx-auto w-full max-w-[720px] px-5 pt-16 pb-24 text-center sm:px-8 sm:pt-22">
    <p class="eyebrow justify-center tracking-[0.12em]">
      <span class="eyebrow-dot"></span>Rouen · Paris · Remote
    </p>
    <h1
      class="mt-5 text-[44px] leading-[1.05] font-medium tracking-[-0.025em] text-strong sm:text-[56px]"
    >
      {copy.title}
    </h1>
    <p class="mx-auto mt-5.5 max-w-[500px] text-lg leading-[1.6] text-pretty text-text/70">
      {copy.intro}
    </p>

    <div
      class="card card-lift mt-12 px-5 pt-9 pb-9 hover:border-text/14 sm:px-8"
      id="contact-card"
      data-u={reversedUser}
      data-d={reversedDomain}
    >
      <p class="font-mono text-[11px] tracking-[0.12em] text-text/45 uppercase">Email</p>

      <p class="mt-3.5">
        <a
          id="contact-email"
          href="#"
          class="inline-block border-b border-magenta pb-0.75 text-xl font-medium tracking-[-0.01em] break-all text-strong transition-colors hover:text-coral sm:text-[28px]"
        >
          {copy.reveal}
        </a>
      </p>

      <p class="mt-7 text-[15px] text-text/65">
        {copy.orLinkedin}<a
          href={siteConfig.linkedin}
          target="_blank"
          rel="nofollow noopener"
          class="link">LinkedIn</a
        >.
      </p>

      <noscript>
        <p class="mt-6 text-sm text-text/65">
          {copy.noscriptBefore}<a href="https://www.colorz.fr" class="link">Colorz</a>.
        </p>
      </noscript>
    </div>
  </section>

  <script>
    // Assemble l'adresse côté client uniquement — jamais présente dans le HTML.
    // Relancé à chaque arrivée sur la page (ClientRouter) : le module ne s'exécute qu'une fois.
    document.addEventListener("astro:page-load", () => {
    const card = document.getElementById("contact-card");
    if (!card) return;
    const emailLink = document.getElementById("contact-email");

    const rev = (s: string) => [...s].reverse().join("");
    const user = rev(card.dataset.u ?? "");
    const domain = rev(card.dataset.d ?? "");
    const address = `${user}${String.fromCharCode(64)}${domain}`;

    if (emailLink) {
      emailLink.textContent = address;
      emailLink.setAttribute("href", `mailto:${address}`);
    }
    });
  </script>
</PageLayout>
