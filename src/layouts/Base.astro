---
import type { SiteMeta } from "@/types";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import { siteConfig } from "@/site.config";

interface Props {
  meta: SiteMeta & { robots?: string };
}

const {
  meta: { title, robots, description = siteConfig.description },
} = Astro.props;
---

<html lang={siteConfig.lang}>
  <head>
    <BaseHead title={title} description={description} robots={robots} />
  </head>
  <body class="flex min-h-dvh flex-col overflow-x-clip bg-bg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-purple focus:px-4 focus:py-2 focus:text-white"
    >
      Aller au contenu
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Raccourci « c » : ouvre la page contact (ignoré dans un champ de saisie).
      window.addEventListener("keydown", (e) => {
        const target = e.target as HTMLElement | null;
        if (target && /INPUT|TEXTAREA|SELECT/.test(target.tagName)) return;
        if (target?.isContentEditable) return;
        if (e.key === "c" && !e.metaKey && !e.ctrlKey && !e.altKey) {
          window.location.href = "/contact";
        }
      });
    </script>
  </body>
</html>
