---
import type { SiteMeta } from "@/types";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import { localeOf, ui } from "@/i18n";

interface Props {
  meta: SiteMeta & { robots?: string };
}

const locale = localeOf(Astro.currentLocale);
const {
  meta: { title, robots, description = ui[locale].siteDescription },
} = Astro.props;
---

<html lang={ui[locale].lang}>
  <head>
    <BaseHead title={title} description={description} robots={robots} />
  </head>
  <body class="flex min-h-dvh flex-col overflow-x-clip bg-bg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-coral focus:px-4 focus:py-2 focus:text-bg"
    >
      {ui[locale].skipToContent}
    </a>
    <Header />
    <main id="main" class="relative flex-1">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="relative">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
