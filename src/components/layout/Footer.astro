---
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();

const links = [
  { href: "/references", label: "références" },
  { href: "/cv", label: "cv" },
  { href: "/contact", label: "contact" },
];
const external = [
  { href: siteConfig.linkedin, label: "linkedin ↗" },
  { href: "https://www.colorz.fr", label: "colorz ↗" },
];
---

<footer class="mt-auto border-t border-white/7 bg-bg-deep">
  <div
    class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-4 px-5 py-5.5 font-mono text-xs text-text/60 sm:px-8"
  >
    <span>v21.0 · © {year} rndgf</span>
    <nav class="flex flex-wrap gap-x-5.5 gap-y-2" aria-label="Navigation pied de page">
      {
        links.map(({ href, label }) => (
          <a href={href} class="text-text/60 transition-colors hover:text-strong">
            {label}
          </a>
        ))
      }
      {
        external.map(({ href, label }) => (
          <a
            href={href}
            target="_blank"
            rel="nofollow noopener"
            class="text-text/60 transition-colors hover:text-strong"
          >
            {label}
          </a>
        ))
      }
      <a
        href="https://dev-null.sh/@rndgf"
        target="_blank"
        rel="nofollow noopener"
        class="text-text/60 transition-colors hover:text-strong"
      >
        <span class="text-[#ff8a4c]">/dev/</span><span class="font-semibold text-strong">null</span> ↗
      </a>
    </nav>
  </div>
</footer>
