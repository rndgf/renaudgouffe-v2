---
import { localeOf, localePath, splitLocale, ui } from "@/i18n";

const locale = localeOf(Astro.currentLocale);
const copy = ui[locale];
// Chemin sans préfixe de langue : sert à marquer le lien courant.
const { path: pathname } = splitLocale(Astro.url.pathname);

const links = [
  { href: "/freelance-shopify", label: copy.freelance },
  { href: "/references", label: copy.references },
  { href: "/cv", label: copy.about },
];
const onContact = pathname === "/contact";
---

<header
  class="sticky top-0 z-20 bg-bg-deep/95"
>
  <nav
    class="mx-auto flex min-h-15 max-w-[1240px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-2 sm:px-8"
    aria-label={copy.mainNav}
  >
    <a
      href={localePath(locale, "/")}
      class="flex items-center font-mono text-[15px] text-text"
      aria-label={copy.home}
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <span class="text-text/50">~/</span><span class="font-medium">rndgf</span><span
        class="mr-1.75 ml-1.5 text-coral"
        aria-hidden="true">❯</span
      ><span
        class="inline-block h-4 w-2 animate-[blink_1.1s_steps(1)_infinite] bg-text"
        aria-hidden="true"></span>
    </a>

    <!-- Mobile : bouton « burger », le menu s'ouvre en volet depuis la droite -->
    <button
      type="button"
      class="-mr-2 flex size-11 items-center justify-center text-text transition-colors hover:text-strong sm:hidden"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={copy.openMenu}
      data-nav-toggle
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <button
      type="button"
      id="nav-backdrop"
      class="cursor-default"
      aria-label={copy.closeMenu}
      tabindex="-1"
      data-nav-toggle></button>

    <div id="site-nav" class="font-mono text-[13px] whitespace-nowrap">
      <button
        type="button"
        class="absolute top-2.5 right-3 flex size-11 items-center justify-center text-text transition-colors hover:text-strong sm:hidden"
        aria-label={copy.closeMenu}
        data-nav-toggle
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
      {
        links.map(({ href, label }) => (
          <a
            href={localePath(locale, href)}
            aria-current={pathname === href ? "page" : undefined}
            class:list={[
              "transition-colors",
              pathname === href
                ? "border-b border-coral pb-0.5 text-strong"
                : "text-text/68 hover:text-strong",
            ]}
          >
            {label}
          </a>
        ))
      }
      <a
        href={localePath(locale, "/contact")}
        aria-current={onContact ? "page" : undefined}
        class:list={[
          "flex h-8 items-center gap-2 rounded-[5px] border border-magenta pr-2 pl-3 text-strong transition-colors hover:bg-magenta/26",
          onContact ? "bg-magenta/26" : "bg-magenta/12",
        ]}
      >
        <span class="text-coral" aria-hidden="true">+</span>{copy.contactMe}
      </a>
    </div>
  </nav>
  <div class="brand-stripes" aria-hidden="true">
    <span class="bg-red"></span><span class="bg-amber"></span><span class="bg-green"></span><span
      class="stripe-cyan bg-cyan"
    ></span>
    <svg width="180" height="72" viewBox="0 0 180 72" fill="none">
      <path d="M180.5 1.5C110 1.5 40 18 0 70" stroke="var(--color-cyan)" stroke-width="3" />
    </svg>
  </div>
</header>

<style>
  /* Mobile : volet fixé à droite, fermé hors écran ; dès 40rem (point sm de Tailwind),
     simple rangée de liens dans la barre. L'en-tête ne doit porter ni filter ni
     backdrop-filter : il deviendrait le bloc conteneur du volet fixé. */
  #site-nav {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 40;
    width: min(78vw, 320px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    padding: 76px 28px 28px;
    font-size: 15px;
    background: var(--color-bg-deep);
    border-left: 1px solid color-mix(in oklab, var(--color-text) 10%, transparent);
    box-shadow: -18px 0 56px rgb(0 0 0 / 0.6);
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform 0.25s ease,
      visibility 0s 0.25s;
  }
  #site-nav[data-open] {
    transform: none;
    visibility: visible;
    transition: transform 0.25s ease;
  }
  #nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: none;
    background: rgb(0 0 0 / 0.45);
  }
  #nav-backdrop[data-open] {
    display: block;
  }
  @media (min-width: 40rem) {
    #site-nav {
      position: static;
      width: auto;
      flex-direction: row;
      align-items: center;
      gap: 26px;
      padding: 0;
      font-size: 13px;
      background: none;
      border: 0;
      box-shadow: none;
      transform: none;
      visibility: visible;
      transition: none;
    }
    #nav-backdrop,
    #nav-backdrop[data-open] {
      display: none;
    }
  }
</style>

<script>
  // Relancé à chaque page (ClientRouter) : l'en-tête est recréé à chaque navigation.
  document.addEventListener("astro:page-load", () => {
    const nav = document.getElementById("site-nav");
    const backdrop = document.getElementById("nav-backdrop");
    const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-nav-toggle]"));
    if (!nav || !backdrop) return;
    const set = (open: boolean) => {
      nav.toggleAttribute("data-open", open);
      backdrop.toggleAttribute("data-open", open);
      for (const b of toggles) b.setAttribute("aria-expanded", String(open));
    };
    for (const b of toggles) b.addEventListener("click", () => set(!nav.hasAttribute("data-open")));
  });
</script>
