---
const pathname = new URL(Astro.request.url).pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/references", label: "Références" },
  { href: "/cv", label: "CV" },
];
---

<header class="fixed inset-x-0 top-0 z-40">
  <div
    class="border-b border-line/70 bg-bg/80 backdrop-blur-md"
  >
    <nav
      class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5"
      aria-label="Navigation principale"
    >
      <a
        href="/"
        class="group flex items-baseline gap-2"
        aria-current={pathname === "/" ? "page" : undefined}
      >
        <span
          class="font-display text-lg font-bold tracking-tight text-text transition-colors group-hover:text-accent-2"
        >
          RNDGF
        </span>
        <span class="hidden font-mono text-[0.65rem] tracking-widest text-muted sm:inline">
          renaud gouffé
        </span>
      </a>

      <div class="flex items-center gap-1 sm:gap-2">
        {
          links.map(({ href, label }) => (
            <a
              href={href}
              aria-current={pathname === href ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-2 text-sm transition-colors",
                pathname === href
                  ? "gradient-text font-semibold"
                  : "text-muted hover:text-text",
              ]}
            >
              {label}
            </a>
          ))
        }
        <a
          href="mailto:renaud.gouffe@gmail.com"
          class="ml-1 rounded-md border border-accent/50 px-3 py-2 text-sm font-medium text-text transition-colors hover:border-accent hover:bg-accent/15 sm:ml-2"
        >
          Contact
        </a>
      </div>
    </nav>
  </div>
</header>
