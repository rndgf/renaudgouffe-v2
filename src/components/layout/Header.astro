---
const pathname = new URL(Astro.request.url).pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/freelance-shopify", label: "freelance" },
  { href: "/references", label: "références" },
  { href: "/cv", label: "cv" },
];
const onContact = pathname === "/contact";
---

<header
  class="sticky top-0 z-20 border-b border-white/7 bg-bg-deep/88 backdrop-blur-md"
>
  <nav
    class="mx-auto flex min-h-15 max-w-[1040px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-2 sm:px-8"
    aria-label="Navigation principale"
  >
    <a
      href="/"
      class="flex items-center font-mono text-[15px] text-text"
      aria-label="rndgf — accueil"
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <span class="text-text/50">~/</span><span class="font-medium">rndgf</span><span
        class="mr-1.75 ml-1.5 text-coral"
        aria-hidden="true">❯</span
      ><span
        class="inline-block h-4 w-2 animate-[blink_1.1s_steps(1)_infinite] bg-text"
        aria-hidden="true"></span>
    </a>

    <div class="flex items-center gap-3 font-mono text-[13px] whitespace-nowrap sm:gap-6.5">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            aria-current={pathname === href ? "page" : undefined}
            class:list={[
              "transition-colors",
              pathname === href
                ? "border-b border-coral pb-0.5 text-strong"
                : "text-text/68 hover:text-strong",
            ]}
          >
            {label}
          </a>
        ))
      }
      <a
        href="/contact"
        aria-current={onContact ? "page" : undefined}
        class:list={[
          "flex h-8 items-center gap-2 rounded-[5px] border border-magenta pr-2 pl-3 text-strong transition-colors hover:bg-magenta/26",
          onContact ? "bg-magenta/26" : "bg-magenta/12",
        ]}
      >
        <span class="text-coral" aria-hidden="true">+</span>me contacter
        <span class="kbd hidden sm:inline" aria-hidden="true">c</span>
      </a>
    </div>
  </nav>
</header>
