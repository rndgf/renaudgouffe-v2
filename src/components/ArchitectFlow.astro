---
// Schéma « Comment je travaille ». Le HTML suffit sans JavaScript ;
// src/scripts/architect-flow.ts trace la courbe, les pictos, la boucle
// d'itération, la ligne qui continue après le go-live et l'animation.
export interface FlowStep {
  tag: string;
  text: string;
  /** Picto qui apparaît au passage de la courbe. */
  icon: "people" | "layers" | "doc" | "code" | "check" | "shop";
  /** Étape vers laquelle on revient après celle-ci (boucle d'itération). */
  loopTo?: number | undefined;
  /** Étapes consécutives de même libellé : regroupées dans un panneau. */
  panel: string;
}

interface Props {
  steps: FlowStep[];
  /** Libellé de la boucle d'itération (« itérer »). */
  loopLabel: string;
}

const { steps, loopLabel } = Astro.props;
---

<div class="af-scroll">
  <ol class="af-flow" id="architect-flow" data-loop-label={loopLabel}>
    {
      steps.map(({ tag, text, icon, loopTo, panel }, i) => (
        <li class="af-step" data-icon={icon} data-loop-to={loopTo} data-panel={panel}>
          <div class="af-tag">
            <b>{String(i + 1).padStart(2, "0")}</b> {tag}
          </div>
          <p>{text}</p>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import "@/scripts/architect-flow";
</script>

<style is:global>
  .af-scroll {
    margin-top: 16px;
    overflow-x: auto;
    /* Marge sous le schéma : un arrondi de sous-pixel ne rogne pas la bordure basse. */
    padding-bottom: 2px;
  }
  .af-flow {
    /* --af-row : haut des étiquettes ; --af-base : ligne de base ; --af-panel : haut des panneaux. */
    --af-row: 264px;
    --af-base: 200px;
    --af-panel: 24px;
    --af-line: rgb(255 255 255 / 0.14);
    --af-off: rgb(234 223 200 / 0.16);
    --af-on: rgb(234 223 200 / 0.5);
    --af-muted: rgb(234 223 200 / 0.35);
    position: relative;
    min-width: 1000px;
    margin: 0;
    padding: var(--af-row) 28px 28px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0 40px;
  }
  .af-flow > svg {
    position: absolute;
    left: 0;
    top: 0;
    overflow: visible;
    pointer-events: none;
  }
  /* Sans script : un filet continu tient lieu de ligne de base. */
  .af-flow::before {
    content: "";
    position: absolute;
    left: 28px;
    right: 28px;
    top: var(--af-base);
    height: 1px;
    background: var(--af-line);
  }
  .af-flow.af-ready::before {
    display: none;
  }

  /* Panneau : il englobe la courbe et les textes ; son titre coupe la bordure haute. */
  .af-panel {
    position: absolute;
    top: var(--af-panel);
    /* Le bas suit celui du schéma, bordure comprise : la zone de défilement ne le coupe pas. */
    bottom: 0;
    box-sizing: border-box;
    border-radius: 10px;
    border: 1px solid rgb(234 223 200 / 0.12);
    background-color: rgb(234 223 200 / 0.03);
    /* Trame de points très discrète, 5 % */
    background-image: radial-gradient(rgb(234 223 200 / 0.05) 1px, transparent 1.2px);
    background-size: 16px 16px;
    pointer-events: none;
  }
  .af-panel span {
    position: absolute;
    top: -13px;
    left: 16px;
    padding: 0 10px;
    background: var(--color-bg);
    font-size: 17px;
    line-height: 24px;
    font-weight: 400;
    white-space: nowrap;
    /* Plus discret que le titre de section, pour ne pas lui faire concurrence. */
    color: rgb(234 223 200 / 0.6);
  }

  /* Étape : l'étiquette numérotée, puis son texte juste en dessous. */
  .af-step {
    position: relative;
  }
  .af-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    box-sizing: border-box;
    padding: 0 10px;
    border-radius: 6px;
    border: 1px solid rgb(234 223 200 / 0.14);
    background: rgb(234 223 200 / 0.02);
    font: 500 12px/1 var(--font-mono);
    white-space: nowrap;
    color: rgb(234 223 200 / 0.55);
    transition:
      color 0.4s,
      background 0.4s,
      border-color 0.4s;
  }
  .af-tag b {
    font-weight: 500;
    color: rgb(234 223 200 / 0.4);
    transition: color 0.4s;
  }
  .af-step p {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.45;
    color: rgb(234 223 200 / 0.5);
    text-wrap: pretty;
    transition: color 0.4s;
  }
  /* Sans script, tout est lisible tout de suite. */
  .af-flow:not(.af-ready) .af-step p,
  .af-step.af-on p {
    color: rgb(234 223 200 / 0.82);
  }
  .af-flow:not(.af-ready) .af-tag,
  .af-step.af-on .af-tag {
    border-color: var(--af-on);
    background: #221b16;
    color: var(--color-strong);
  }
  .af-flow:not(.af-ready) .af-tag b,
  .af-step.af-on .af-tag b {
    color: var(--color-coral);
  }

  /* Tracé */
  .af-base,
  .af-next {
    stroke-width: 1.5;
    stroke-dasharray: 1 7;
    stroke-linecap: round;
  }
  .af-base {
    stroke: var(--af-muted);
  }
  /* Après le go-live, la ligne continue : ses points avancent vers la flèche. */
  .af-next {
    stroke: var(--af-muted);
    stroke-width: 2;
    transition: stroke 0.6s;
  }
  .af-arrow {
    fill: none;
    stroke: var(--af-muted);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.6s;
  }
  .af-next.af-on {
    stroke: rgb(244 184 52 / 0.75);
    animation: af-march 0.5s linear infinite;
  }
  .af-arrow.af-on {
    stroke: rgb(244 184 52 / 0.75);
  }
  @keyframes af-march {
    to {
      stroke-dashoffset: -8;
    }
  }
  .af-rail,
  .af-lit,
  .af-orbit,
  .af-orbit-lit {
    fill: none;
    stroke-linecap: round;
  }
  .af-rail {
    stroke: var(--af-line);
    stroke-width: 1.5;
  }
  .af-lit {
    stroke: var(--color-coral);
    stroke-width: 2.5;
  }
  /* Boucle d'itération : volontairement discrète, elle ne doit pas concurrencer la courbe. */
  .af-orbit {
    stroke: rgb(234 223 200 / 0.08);
    stroke-width: 1.25;
    stroke-dasharray: 0.1 6;
  }
  .af-orbit-lit {
    stroke: rgb(244 184 52 / 0.35);
    stroke-width: 1.5;
  }
  /* Chevrons qui donnent le sens de la boucle : absents avant, ils tournent avec elle puis restent. */
  .af-orbit-arrow {
    fill: none;
    stroke: rgb(244 184 52 / 0.6);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .af-orbit-arrow.af-on {
    opacity: 1;
  }
  .af-head {
    fill: #fff4dc;
    filter: drop-shadow(0 0 5px rgb(242 98 43 / 0.9));
  }
  /* Tête de la boucle : la bille devient une flèche le temps du tour. */
  .af-head-arrow {
    fill: rgb(244 184 52 / 0.8);
  }
  .af-wave {
    fill: none;
    stroke: var(--color-coral);
    stroke-width: 1;
  }
  .af-burst {
    font-family: var(--font-mono);
    font-weight: 500;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  /* Repères : départ, carrés d'étape, anneau du go-live */
  .af-start,
  .af-sq {
    position: absolute;
    box-sizing: border-box;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .af-start {
    width: 11px;
    height: 11px;
    border: 1.5px solid rgb(234 223 200 / 0.6);
    border-radius: 2px;
    background: var(--color-bg);
  }
  .af-sq {
    width: 8px;
    height: 8px;
    border-radius: 1.5px;
    background: #5c5148;
    transition:
      background 0.3s,
      box-shadow 0.5s;
  }
  .af-sq.af-on {
    background: var(--color-amber);
  }
  .af-sq.af-end {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--af-muted);
    background: var(--color-bg);
  }
  .af-sq.af-end.af-on {
    border-color: var(--color-amber);
    background: var(--color-amber);
    box-shadow:
      0 0 0 6px rgb(244 184 52 / 0.16),
      0 0 18px 4px rgb(244 184 52 / 0.35);
  }

  /* Traits de rappel : carré → étiquette, picto → courbe */
  .af-lead {
    position: absolute;
    background: var(--af-off);
    pointer-events: none;
    transition:
      background 0.4s,
      opacity 0.4s;
  }
  .af-lead.af-on {
    background: var(--af-on);
  }
  .af-lead.af-pic-lead {
    background: var(--af-on);
    opacity: 0;
  }
  .af-lead.af-pic-lead.af-on {
    opacity: 1;
  }

  /* Picto : apparaît au passage de la courbe, puis reste */
  .af-pic {
    position: absolute;
    width: 44px;
    height: 44px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background: #221b16;
    color: var(--af-muted);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.55);
    pointer-events: none;
    transition:
      opacity 0.35s,
      color 0.35s,
      transform 0.5s cubic-bezier(0.2, 1.5, 0.4, 1);
  }
  .af-pic svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .af-pic svg.af-filled {
    fill: currentColor;
    stroke: none;
  }
  .af-pic.af-on {
    opacity: 1;
    color: var(--color-amber);
    transform: translate(-50%, -50%) scale(1);
  }
  .af-pic.af-on.af-pulse {
    transform: translate(-50%, -50%) scale(1.05);
  }
  .af-loop-label {
    position: absolute;
    transform: translateX(-50%);
    font: 400 10px/1.2 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(244 184 52 / 0.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .af-loop-label.af-on {
    opacity: 1;
  }

  /* Mobile : la ligne devient verticale ; pictos à gauche, étiquettes et textes à droite. */
  @media (max-width: 759px) {
    .af-scroll {
      overflow-x: visible;
    }
    .af-flow {
      min-width: 0;
      /* En bas : la place de la ligne qui continue après le go-live. */
      padding: 16px 0 64px;
      grid-template-columns: 1fr;
      gap: 0;
    }
    .af-flow::before {
      left: 96px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
    }
    /* Hauteur minimale par étape : le tracé garde un rythme régulier. */
    .af-step {
      padding: 6px 16px 24px 124px;
      min-height: 150px;
      box-sizing: border-box;
    }
    .af-step p {
      margin-top: 10px;
      font-size: 13px;
    }
    .af-pic {
      width: 40px;
      height: 40px;
    }
    .af-pic svg {
      width: 18px;
      height: 18px;
    }
    .af-loop-label {
      font-size: 10px;
    }
  }
</style>
