---
// Bandeau d'appel à l'action en bas de page.
import { siteConfig } from "@/site.config";
import { SHOPIFY_ICON } from "@/data/shopify-icon";
import { localeOf, localePath, ui } from "@/i18n";

interface Props {
  title: string;
  text: string;
  /** Affiche le logo Shopify à gauche du texte. */
  shopify?: boolean;
}

const { title, text, shopify = false } = Astro.props;
const locale = localeOf(Astro.currentLocale);
---

<section class="pt-8 pb-9 sm:pt-16 sm:pb-24">
  <div
    class="cta-band flex flex-wrap items-center justify-between gap-5 px-5 py-7 sm:gap-6 sm:px-9 sm:py-10"
  >
    <div class:list={["flex items-center gap-5.5", shopify ? "max-w-[600px]" : "max-w-[520px]"]}>
      {
        shopify && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox={SHOPIFY_ICON.viewBox}
            class="size-10 shrink-0 text-bg"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={SHOPIFY_ICON.path} />
          </svg>
        )
      }
      <div class="relative">
        <h2 class="text-[30px] font-semibold tracking-[-0.015em] text-bg">{title}</h2>
        <p class="mt-3 text-base leading-[1.6] text-bg">{text}</p>
      </div>
    </div>
    <div class="relative flex flex-wrap items-center gap-3 sm:mr-[120px]">
    <a href={localePath(locale, "/contact")} class="btn-white pr-3">
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="M3 7l9 6 9-6"></path>
      </svg>{ui[locale].contactMe}
    </a>
    <a
      href={siteConfig.linkedin}
      target="_blank"
      rel="nofollow noopener"
      class="flex h-11 items-center rounded-[5px] border border-bg/60 px-4.5 font-mono text-sm text-bg transition-colors hover:bg-bg/10"
      >linkedin ↗</a
    >
    </div>
  </div>
</section>
