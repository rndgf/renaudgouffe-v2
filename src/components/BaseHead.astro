---
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@/site.config";
import { localeOf, localePath, splitLocale, ui } from "@/i18n";
import "@/styles/global.css";
// Préchargement des deux fontes critiques (corps + mono de la navigation) : supprime le
// décalage de mise en page (CLS) au swap des polices.
import jostWoff2 from "@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url";
import plexMonoWoff2 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";

interface Props {
  title: string;
  description?: string | undefined;
  robots?: string | undefined;
}

const { title, description, robots } = Astro.props;
const siteTitle = `${title} • ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url);
const locale = localeOf(Astro.currentLocale);
const { path } = splitLocale(Astro.url.pathname);
const alternate = (l: "fr" | "en") => new URL(localePath(l, path), Astro.site ?? siteConfig.url);

// Données structurées : profil professionnel (schema.org)
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.author,
  url: siteConfig.url,
  jobTitle: ui[locale].jobTitle,
  knowsAbout: ui[locale].knowsAbout,
  worksFor: {
    "@type": "Organization",
    name: "Colorz",
    url: "https://www.colorz.fr",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Rouen",
    addressRegion: ui[locale].region,
    addressCountry: "FR",
  },
  sameAs: [siteConfig.linkedin],
});
---

<meta charset="utf-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, shrink-to-fit=no"
/>

<title>{siteTitle}</title>

<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="fr" href={alternate("fr")} />
<link rel="alternate" hreflang="en" href={alternate("en")} />
<link rel="alternate" hreflang="x-default" href={alternate("fr")} />

<!-- Langue : choix du pied de page (localStorage), sinon langue du navigateur.
     Exécuté avant le rendu, une seule fois par chargement complet (ClientRouter
     ne rejoue pas un script inline identique d'une page à l'autre). -->
<script is:inline>
  (function () {
    var p = location.pathname;
    var current = /^\/en(\/|$)/.test(p) ? "en" : "fr";
    var wanted;
    try {
      wanted = localStorage.getItem("lang");
    } catch (e) {}
    if (wanted !== "fr" && wanted !== "en") wanted = /^fr\b/i.test(navigator.language) ? "fr" : "en";
    if (wanted === current) return;
    var target = wanted === "en" ? "/en" + (p === "/" ? "/" : p) : p.replace(/^\/en(\/|$)/, "/");
    location.replace(target + location.search + location.hash);
  })();
</script>

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={ui[locale].ogLocale} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:image" content={new URL("/og.jpg", Astro.site ?? siteConfig.url)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={new URL("/og.jpg", Astro.site ?? siteConfig.url)} />

<link rel="preload" href={jostWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={plexMonoWoff2} as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#15110e" />

<!-- Transitions entre pages (fondu) : le script du schéma se relance sur astro:page-load -->
<ClientRouter />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link href="/apple-touch-icon.png" rel="apple-touch-icon" />
<link href="/manifest.webmanifest" rel="manifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script type="application/ld+json" set:html={jsonLd} />
